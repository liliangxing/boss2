.class public Lx5/b;
.super Lh5/h;
.source "SourceFile"


# annotations
.annotation system Ldalvik/annotation/Signature;
    value = {
        "Lh5/h<",
        "Lx5/c;",
        ">;"
    }
.end annotation


# direct methods
.method public constructor <init>(Lx5/c;)V
    .registers 2

    invoke-direct {p0, p1}, Lh5/h;-><init>(Lh5/b;)V

    return-void
.end method
