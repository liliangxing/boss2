.class public Lp5/c;
.super Lh5/h;
.source "SourceFile"


# annotations
.annotation system Ldalvik/annotation/Signature;
    value = {
        "Lh5/h<",
        "Lp5/d;",
        ">;"
    }
.end annotation


# direct methods
.method public constructor <init>(Lp5/d;)V
    .registers 2

    invoke-direct {p0, p1}, Lh5/h;-><init>(Lh5/b;)V

    return-void
.end method
