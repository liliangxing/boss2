    const-string v2, "\u0018\u0008 \u0001(\t\u0012&\n\u000ehighlightParts\u0018\t \u0003(\u000b2\u000e.TechwolfSlice\u0012 \n\u0008dimParts\u0018\n \u0003(\u000b2\u000e.TechwolfSlice\u0012\u0010\n\u0008subTitle\u0018\u000b \u0001(\t\u0012\u000e\n\u0006extend\u0018\u000c \u0001(\t\":\n\u000eTechwolfNotify\u0012\u000c\n\u0004text\u0018\u0001 \u0002(\t\u0012\u000b\n\u0003url\u0018\u0002 \u0001(\t\u0012\r\n\u0005title\u0018\u0003 \u0001(\t\"?\n\u000eTechwolfButton\u0012\u000c\n\u0004text\u0018\u0001 \u0002(\t\u0012\u000b\n\u0003url\u0018\u0002 \u0001(\t\u0012\u0012\n\ntemplateId\u0018\u0003 \u0001(\u0005\"\u008c\u0002\n\u000eTechwolfDialog\u0012\u000c\n\u0004text\u0018\u0001 \u0002(\t\u0012 \n\u0007buttons\u0018\u0002 \u0003(\u000b2\u000f.TechwolfButton\u0012\u0010\n\u0008operated\u0018\u0003 \u0002(\u0008\u0012\u0011\n\tclickMore\u0018\u0004 \u0001(\u0008\u0012\u000c\n\u0004type\u0018\u0005 \u0001(\u0005\u0012\u0015\n\rbackgroundUrl\u0018\u0006 \u0001(\t\u0012\u000f\n\u0007timeout\u0018\u0007 \u0001(\u0003\u0012\u001b\n"

